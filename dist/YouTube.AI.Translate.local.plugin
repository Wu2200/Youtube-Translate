#!name = YouTube AI 双语字幕
#!desc = 使用自定义 OpenAI 兼容接口将 YouTube 字幕翻译为双语字幕，请在 Loon 中填写 API 地址、模型名称和 API Key。
#!author = aot & Claude
#!homepage = https://github.com/Wu2200/Youtube-Translate
#!tag = YouTube,字幕,AI,翻译
#!system = iOS,iPadOS,macOS
#!system_version = 15
#!loon_version = 3.4.0(962)
#!version = 0.10.0

[Argument]
ai_enabled = switch,true,tag=AI 翻译,desc=关闭后不做翻译，只显示 YouTube 原文字幕
provider = select,"OpenAI-Compatible",tag=接口协议,desc=使用支持 OpenAI Chat Completions 的接口
model = input,"gpt-4o-mini",tag=模型,desc=填写自定义接口支持的模型名称
base_url = input,"https://api.openai.com/v1",tag=API 地址,desc=填写兼容接口基础地址
api_key = input,"",tag=API Key,desc=填写自定义接口提供的密钥
target_language = select,"简体中文","繁體中文","日本語","한국어","English",tag=翻译成,desc=如果在 YouTube 字幕菜单里选了自动翻译成某种语言，以菜单为准
secondary_language = select,"English","简体中文","繁體中文","日本語","한국어",tag=同语言视频翻译成,desc=视频本身就是翻译目标语言时，改翻成这个语言
Position = select,"原文在上","译文在上",tag=字幕顺序,desc=每种语言各占一行
ShowOnly = switch,false,tag=只显示译文,desc=开启后不显示原文
background_translate = switch,true,tag=播放时后台续翻,desc=长视频第一次没翻完时，看视频期间借 YouTube 的观看统计请求在后台接着翻，翻完会通知；之后重新打开视频即可看到完整双语字幕。中途不看的视频也可能被翻完，会多用一些 API 额度
sentence_split = switch,true,tag=按句断句,desc=自动字幕常把上一句结尾和下一句开头放在同一条里。开启后按句子重新分条，原文和译文都更通顺；没有标点的字幕保持原样。显示时间按语速估算，如有异常可关闭
strict_order = switch,true,tag=顺序防跳段,desc=开启后前两批小包护航，且只显示从开头连续翻完的字幕，最后窗口优先填补前序缺口；后续已翻批次仍会保存缓存
max_wait_ms = input,"7000",tag=前台超时(ms),desc=打开视频首次等待翻译的最长时间（毫秒，3000～30000），单次请求超时会同步放宽到该上限
foreground_max_cues = input,"500",tag=首次最多翻译条数,desc=首次打开视频前台最多接管的字幕条数（0～5000，填 0 表示不限制全量尝试）。超出部分交由后台续翻
max_batch_items = input,"30",tag=每批字幕条数,desc=每次请求最多翻译的字幕条数（5～200）。留空或填 0 则按模型实测速度自动调整
max_batch_chars = input,"3500",tag=每批最大字符数,desc=按文本量限制单批大小（500～50000）。句子较长时自动减少本批条数，避免单批过慢超时
concurrency = input,"5",tag=前台并发数,desc=首次翻译同时发出的请求数量（1～16）。设成 1 为严格逐批顺序翻译；越大吞吐越高，过大易触发限流
custom_prompt = input,"",tag=额外翻译要求,desc=例如人名保留英文或科技术语按业内习惯翻译。不要在这里填写密钥
LogLevel = select,"INFO","DEBUG","WARN","ERROR","OFF",tag=日志等级,desc=排查问题时查看 Loon 脚本日志；日志不记录 API Key 和字幕全文

[Rule]
# YouTube 走 QUIC（UDP）时 Loon 无法解密，字幕、观看统计和去广告脚本都会被绕过。
# 只拒绝 YouTube 相关域名的 QUIC，App 会自动改走 TCP；其他 App 不受影响
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,youtube.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
AND,((PROTOCOL,QUIC),(DOMAIN,youtubei.googleapis.com)),REJECT

[Script]
# 只拦截字幕接口（/api/timedtext），不碰 player、get_watch 等播放信息接口，
# 避免和 YouTube 去广告插件处理同一个请求导致去广告失效
# AI 翻译：请求阶段去掉 tlang（YouTube 对它返回 429），响应阶段直接翻原文字幕
http-request ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ script-path=dualsubs-ai.bundle.js, timeout=10, tag=AI 字幕请求, argument=[{ai_enabled},{provider},{model},{api_key},{base_url},{target_language},{secondary_language},{Position},{ShowOnly},{sentence_split},{background_translate},{strict_order},{max_wait_ms},{foreground_max_cues},{max_batch_items},{max_batch_chars},{concurrency},{custom_prompt},{LogLevel}]
# Loon 按改写前的地址匹配响应规则，所以这里匹配原始 timedtext 地址；脚本内部按 max_wait_ms 控制交卷，规则超时设为 35 秒以便手动测试极限
http-response ^https?:\/\/(www|m)\.youtube\.com\/api\/timedtext(\?.+)?$ requires-body=1, max-size=0, script-path=dualsubs-ai.bundle.js, timeout=35, tag=AI 字幕响应, argument=[{ai_enabled},{provider},{model},{api_key},{base_url},{target_language},{secondary_language},{Position},{ShowOnly},{sentence_split},{background_translate},{strict_order},{max_wait_ms},{foreground_max_cues},{max_batch_items},{max_batch_chars},{concurrency},{custom_prompt},{LogLevel}]

# 后台续翻：借播放时的观看统计请求（不碰去广告插件拦截的 stats/ads），每次最多占用约 40 秒
http-request ^https?:\/\/s\.youtube\.com\/api\/stats\/(watchtime|qoe|playback)(\?.*)?$ script-path=dualsubs-ai.bundle.js, timeout=42, tag=AI 字幕后台续翻, argument=[{ai_enabled},{provider},{model},{api_key},{base_url},{target_language},{secondary_language},{Position},{ShowOnly},{sentence_split},{background_translate},{strict_order},{max_wait_ms},{foreground_max_cues},{max_batch_items},{max_batch_chars},{concurrency},{custom_prompt},{LogLevel}]

[MITM]
hostname = www.youtube.com, m.youtube.com, s.youtube.com
